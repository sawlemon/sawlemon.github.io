---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { isExternalPost, postHref } from '../../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);
const monthYear = (d: Date) => d.toLocaleDateString('en', { month: 'long', year: 'numeric' });
const coverSrc = posts.find((p) => p.data.heroImage)?.data.heroImage?.src ?? '';
---

<BaseLayout title="Writing | Solomon Raj A" description="Articles and technical notes by Solomon Raj A." page="blog">
  <main id="main">
    <header class="page-hero wrap">
      <p class="sec-num">Writing</p>
      <h1 class="h1-long">Notes and articles.</h1>
    </header>
    <section class="wrap" aria-label="Posts" style="padding-bottom:5rem">
      <div class="post-list">
        {posts.map((post) => {
          const external = isExternalPost(post);
          const href = postHref(post);
          return (
            <a class="post-row" href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined} data-cover={post.data.heroImage?.src}>
              <time class="mono">{monthYear(post.data.publishedDate)}{external && post.data.originalPublication ? ` · ${post.data.originalPublication}` : ''}</time>
              <div>
                {post.data.heroImage && (
                  <div class="inline-cover"><img src={post.data.heroImage.src} alt={post.data.heroImage.alt} width={post.data.heroImage.width} height={post.data.heroImage.height} loading="lazy" decoding="async" /></div>
                )}
                <h2>{post.data.title}{external && '\u00A0↗'}</h2>
                <p>{post.data.description}</p>
              </div>
              <span class="arr" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
            </a>
          );
        })}
      </div>
    </section>
    {coverSrc && (
      <div class="hover-cover" data-hover-cover aria-hidden="true"><img alt="" src={coverSrc} /></div>
    )}
  </main>

  <div class="slab-end" slot="tail">
    <Footer />
  </div>
</BaseLayout>
