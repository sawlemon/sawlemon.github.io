---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import musicData from '../data/music.json';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const MONTHS_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const fmt = (n: number) => n.toLocaleString('en-IN');

type Year = {
  minutes: number;
  months: { month: number; label: string; minutes: number }[];
  topSongs: { title: string; artist: string; artwork: string | null; plays: number }[];
  topArtists: { name: string; minutes: number; plays: number }[];
  playlist: { id: string; url: string; name: string } | null;
};

const music = musicData as unknown as { generated: string; years: Record<string, Year> };
const years = Object.keys(music.years).filter((y) => music.years[y]?.topSongs?.length && music.years[y]?.topArtists?.length).sort().reverse();
const latest = years[0];
const oldest = years[years.length - 1];
const total = years.reduce((t, y) => t + music.years[y].minutes, 0);
const range = oldest === latest ? latest : `${oldest}–${latest}`;
const asOf = music.generated ? new Date(`${music.generated}T00:00:00`) : null;
const asOfYear = asOf ? String(asOf.getFullYear()) : years[0];
const asOfLabel = asOf ? asOf.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
const embedUrl = (p: { id: string; url: string }) => {
  const slug = p.url.split('/playlist/')[1]?.split('/')[0] ?? '';
  return `https://embed.music.apple.com/in/playlist/${slug}/${p.id}?theme=auto`;
};
---

<BaseLayout title="Music | Solomon Raj A" description={`My Apple Music Replay listening stats — top songs, artists, and minutes per month for ${range}.`} page="music">
  <main id="main">
    <section class="page-hero wrap" aria-labelledby="music-title">
      <p class="sec-num">Apple Music Replay</p>
      <h1 id="music-title">Music</h1>
      <div class="page-hero-grid">
        <div>
          <p class="subpage-role mono">{site.role}</p>
          <p class="lead">Everything I’ve played since Replay started tracking — {fmt(total)} minutes across {range}.</p>
        </div>
        <p class="stat-big"><strong data-count={total}>{fmt(total)}</strong><span class="mono">minutes · {range}</span></p>
      </div>
      <div class="year-dial" role="tablist" aria-label="Replay year" data-years>
        {years.map((y) => (
          <button type="button" role="tab" class="year-button" id={`tab-${y}`} aria-controls={`panel-${y}`} aria-selected={y === latest ? 'true' : 'false'} tabindex={y === latest ? 0 : -1} data-year={y}>{y}</button>
        ))}
      </div>
    </section>

    <div data-panels>
      {years.map((y) => {
        const d = music.years[y];
        const months = MONTHS.map((m, i) => ({ m, long: MONTHS_LONG[i], minutes: d.months.find((x) => x.month === i + 1)?.minutes || 0 }));
        const max = Math.max(...months.map((m) => m.minutes), 1);
        const peak = months.reduce((a, m) => (m.minutes > a.minutes ? m : a), months[0]);
        const song = d.topSongs[0];
        const artist = d.topArtists[0];
        const aMax = artist.minutes;
        return (
          <div class="year-panel" role="tabpanel" id={`panel-${y}`} aria-labelledby={`tab-${y}`} tabindex="0" hidden={y !== latest}>
            <section class="sub-sec wrap" aria-labelledby={`ov-${y}`}>
              <div class="sub-head"><h2 id={`ov-${y}`}>{y} / Overview</h2></div>
              <div class="now-playing">
                <div class="record" aria-hidden="true">
                  <div class="disc"></div>
                  <div class="label">{song.artwork && <img src={song.artwork} alt="" />}</div>
                  <span class="hole"></span>
                </div>
                <div>
                  <p class="np-kicker mono"><span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>top song · {song.plays} plays</p>
                  <p class="np-title">{song.title}</p>
                  <p class="np-artist">{song.artist}</p>
                  <div class="np-stats">
                    <div class="np-stat"><span class="mono">minutes listened</span><b data-count={d.minutes}>{fmt(d.minutes)}</b></div>
                    <div class="np-stat"><span class="mono">top artist · {fmt(artist.minutes)} min</span><b>{artist.name}</b></div>
                  </div>
                </div>
              </div>
            </section>

            <section class="sub-sec wrap" aria-labelledby={`ml-${y}`}>
              <div class="sub-head"><h3 id={`ml-${y}`}>Monthly listening</h3></div>
              <ol class="meter" aria-hidden="true">
                {months.map((m) => {
                  const lit = m.minutes ? Math.max(1, Math.round((m.minutes / max) * 12)) : 0;
                  return (
                    <li class={m.minutes && m === peak ? 'peak' : ''}>
                      <span class="cells">{Array.from({ length: 12 }, (_, k) => <i class={11 - k < lit ? 'on' : ''}></i>)}</span>
                      <span class="v">{m.minutes ? fmt(m.minutes) : '—'}</span>
                      <span class="m">{m.m}</span>
                    </li>
                  );
                })}
              </ol>
              <p class="chart-note">
                Minutes per month{y === asOfYear && asOf ? ` · data as of ${asOfLabel} · ${MONTHS_LONG[asOf.getMonth()]} is still in progress` : ''}
                {d.months.length < 12 ? ' · gaps mean no listening data' : ''}.
              </p>
              <details class="chart-values">
                <summary>View monthly values</summary>
                <table>
                  <caption class="sr-only">Minutes listened per month in {y}</caption>
                  <thead><tr><th scope="col">Month</th><th scope="col">Minutes</th></tr></thead>
                  <tbody>
                    {months.map((m) => <tr><th scope="row">{m.long}</th><td>{m.minutes ? fmt(m.minutes) : '—'}</td></tr>)}
                  </tbody>
                </table>
              </details>
            </section>

            <section class="sub-sec wrap" aria-labelledby={`top-${y}`}>
              <div class="sub-head"><h2 id={`top-${y}`}>{y} / Top artists &amp; songs</h2></div>
              <div class="top-two">
                <div>
                  <div class="sub-head"><h3>Top artists</h3></div>
                  <ol class="artist-chart">
                    {d.topArtists.slice(0, 10).map((a, i) => (
                      <li>
                        <span class="r">{String(i + 1).padStart(2, '0')}</span>
                        <span class="n" style={`--fs:${(1.05 + (a.minutes / aMax) * 2.4).toFixed(2)}rem`}>{a.name}</span>
                        <span class="s">{fmt(a.minutes)} min · {a.plays} plays</span>
                      </li>
                    ))}
                  </ol>
                </div>
                <div>
                  <div class="sub-head"><h3>Top songs</h3></div>
                  <ol class="album-grid">
                    {d.topSongs.slice(0, 10).map((s, i) => (
                      <li class="album">
                        <figure>
                          <div class="art">
                            {s.artwork && <img src={s.artwork} alt="" loading="lazy" width="200" height="200" />}
                            <span class="rk" aria-hidden="true">{i + 1}</span>
                          </div>
                          <figcaption>
                            <b><span class="sr-only">{i + 1}. </span>{s.title}</b>
                            <span>{s.artist}</span>
                            <small>{s.plays} plays</small>
                          </figcaption>
                        </figure>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            </section>

            {d.playlist && (
              <section class="sub-sec wrap" aria-labelledby={`pl-${y}`}>
                <div class="sub-head"><h2 id={`pl-${y}`}>{y} / Playlist</h2></div>
                <div class:list={['playlist-card', { 'no-embed': y !== '2025' }]}>
                  <div>
                    <h3>{d.playlist.name}</h3>
                    {y !== asOfYear ? (
                      <>
                        <p class="playlist-note">The playlist Apple generated from my {y} listening.</p>
                        <a class="text-link" href={d.playlist.url} target="_blank" rel="noreferrer">Open in Apple Music <span aria-hidden="true">↗</span></a>
                      </>
                    ) : (
                      <>
                        <p class="playlist-note">The {y} playlist is still growing — Apple enables embedding once the year wraps up.</p>
                        <a class="text-link" href={d.playlist.url} target="_blank" rel="noreferrer">Open Replay {y} in Apple Music <span aria-hidden="true">↗</span></a>
                      </>
                    )}
                  </div>
                  {y === '2025' && (
                    <div class="playlist-embed">
                      <iframe allow="autoplay *; encrypted-media *; fullscreen *; picture-in-picture *" loading="lazy" src={embedUrl(d.playlist)} title={`${d.playlist.name} playlist player`}></iframe>
                    </div>
                  )}
                </div>
              </section>
            )}
          </div>
        );
      })}
    </div>
  </main>

  <div class="slab-end" slot="tail">
    <Footer />
  </div>
</BaseLayout>
