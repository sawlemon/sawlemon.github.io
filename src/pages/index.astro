---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { credentials, education, experience, interests, projects, site } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---

<BaseLayout title="Solomon Raj A | Security, cloud, and AI systems" description={site.description}>
  <Header />
  <main id="main" class="wrap main-grid">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">SOLOMON RAJ A / CYBERSECURITY</p>
        <h1 id="hero-title">Security,<br />cloud, and<br />AI systems.</h1>
        <p class="hero-copy">I’m a Senior Consultant in Cybersecurity at Presidio, specializing in SIEM implementations and endpoint security. My background includes five years across cybersecurity and cloud engineering.</p>
        <div class="actions"><a class="button button-primary" href="#projects">Explore my work</a><a class="text-link" href="#connect">Connect with me <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-profile">
        <div class="portrait" role="img" aria-label="Abstract placeholder portrait made from a security signal grid"><span>SR</span></div>
        <dl class="hero-facts"><div><dt>Location</dt><dd>Coimbatore, India</dd></div><div><dt>Experience</dt><dd>5+ years</dd></div></dl>
      </div>
    </section>

    <section id="about" class="section about"><p class="section-label">01 / ABOUT</p><div><h2>I like making complex systems easier to understand, secure, and explain.</h2><div class="two-column"><p>Solomon progressed from Cloud Engineer Trainee to Senior Consultant at Presidio, completed an MTech in Cloud Computing at BITS Pilani and a BE in Computer Science and Engineering at KGiSL Institute of Technology, and participates in mentoring, public speaking, technical communities, and knowledge sharing.</p><ul class="facts-list"><li>Cybersecurity</li><li>Cloud engineering</li><li>AI security</li><li>Community</li></ul></div></div></section>

    <section id="interests" class="section"><p class="section-label">02 / INTERESTS</p><div class="interest-grid">{interests.map(([title, description], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{description}</p></article>)}</div></section>

    <section id="projects" class="section"><p class="section-label">03 / SELECTED WORK</p><div class="project-grid">{projects.map((project) => <article class:list={['project-card', project.status && 'coming-soon']}><div class="project-visual"><span>{project.status ? '◌' : '▦'}</span></div><div><p class="eyebrow">{project.status ? 'COMING SOON' : 'FEATURED PROJECT'}</p><h3>{project.title}</h3><p>{project.description}</p><ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>{project.href && <div class="project-links"><a class="text-link" href={project.href} target="_blank" rel="noreferrer">View live ↗</a>{project.sourceHref && <a class="text-link" href={project.sourceHref} target="_blank" rel="noreferrer">Source ↗</a>}</div>}</div></article>)}</div></section>

    <section class="section" id="writing"><p class="section-label">04 / NOTES & MEDIA</p>{posts.length ? <div class="post-list">{posts.map((post) => <article><p class="eyebrow">{post.data.publishedDate.toLocaleDateString('en', { month: 'short', year: 'numeric' })}</p><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</div> : <div class="empty-state"><h2>Writing is coming soon.</h2><p>Articles will be published here as Markdown files in this repository.</p><a class="text-link" href="/blog/">Visit the blog <span aria-hidden="true">→</span></a></div>}</section>

    <section id="experience" class="section"><p class="section-label">05 / EXPERIENCE</p><div class="timeline">{experience.map(([role, dates]) => <article><span></span><div><h3>{role}</h3><p>Presidio · {dates}</p></div></article>)}</div><div class="education-grid">{education.map(([institution, degree, dates]) => <article><h3>{institution}</h3><p>{degree}</p><small>{dates}</small></article>)}</div></section>

    <section class="section"><p class="section-label">06 / CREDENTIALS</p><div class="credential-grid">{credentials.map(([name, note]) => <article><span>{name}</span>{note && <small class:list={{ latest: note === 'Latest' }}>{note}</small>}</article>)}</div><a class="text-link" href={site.linkedin} target="_blank" rel="noreferrer">View complete credentials on LinkedIn ↗</a></section>

    <section id="connect" class="connect-section"><p class="section-label">07 / CONNECT</p><h2>I’m always interested in thoughtful security work, AI experiments, and conversations with people who enjoy building and sharing.</h2><div class="contact-list"><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href={site.github} target="_blank" rel="noreferrer">GitHub <span>↗</span></a><span aria-disabled="true">YouTube <small>Coming soon</small></span><span aria-disabled="true">Email <small>Coming soon</small></span></div></section>
  </main>
  <Footer />
</BaseLayout>
