---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { credentials, education, experience, interestGroups, projects, site } from '../data/site';
import brandLogos from '../data/brand-logos.json';
import { isExternalPost, postHref } from '../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);
const post = posts[0];
const postExternal = post ? isExternalPost(post) : false;
const postUrl = post ? postHref(post) : '/blog/';

// Staircase runs oldest → newest so the career climbs left to right.
const steps = [...experience].reverse();
const letter = (word: string, start: number) =>
  word
    .split('')
    .map((c, i) => `<span class="ch" style="--i:${start + i}">${c}</span>`)
    .join('');
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, '');
const stamp = (issuer: string) => `${issuer} · Certified · ${issuer} · Certified · `;
const monthYear = (d: Date) => d.toLocaleDateString('en', { month: 'short', year: 'numeric' });
---

<BaseLayout title="Solomon Raj A | Security, cloud, and AI systems" description={site.description} page="home">
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-slice" data-slice aria-hidden="true"><svg viewBox="0 0 200 200"><use href="#lemon" /></svg></div>
      <div class="hero-stack">
        <h1 id="hero-title" class="hero-name" data-hero-name>
          <span class="sr-only">Solomon Raj</span>
          <span class="ln l1" aria-hidden="true" data-fit-line set:html={letter('Solomon', 0)} />
          <span class="ln l2" aria-hidden="true" set:html={letter('Raj', 7)} />
        </h1>
        <div class="hero-cta">
          <a class="btn-connect" href="#connect">Connect with me <span class="arr"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></span></a>
          <span class="scroll-cue mono" aria-hidden="true"><i></i>Scroll</span>
        </div>
      </div>
    </section>

    <section id="about" class="sec wrap" aria-labelledby="about-title">
      <div class="about-grid">
        <div>
          <p class="about-kicker mono">01 — About · Cybersecurity / Cloud / AI</p>
          <h2 id="about-title" class="manifesto" data-manifesto>
            I like making complex systems easier to <span class="mark">understand</span>, <span class="mark">secure</span>, and <span class="mark">explain</span>.
          </h2>
          <div class="about-copy">
            <p class="rv">I’m a Principal Consultant in Cybersecurity at Presidio, specializing in SIEM implementations and endpoint security. My background includes five years across cybersecurity and cloud engineering.</p>
            <p class="rv" style="--d:.1s">Beyond client work, I mentor, give talks, and stay involved in technical communities, sharing what I learn as I go.</p>
          </div>
        </div>
        <div class="badge-wrap" data-tilt-wrap>
          <article class="badge" data-tilt aria-label="Profile card">
            <div class="badge-slot" aria-hidden="true"></div>
            <div class="badge-top"><span class="wordmark"><svg viewBox="0 0 200 200" aria-hidden="true"><use href="#lemon" /></svg>{site.handle}</span><span class="mono">01</span></div>
            <div class="badge-photo" aria-hidden="true"><b>SR</b></div>
            <p class="badge-name">Solomon Raj A</p>
            <dl>
              <div><dt>Role</dt><dd>{site.role}</dd></div>
              <div><dt>Location</dt><dd>Coimbatore, India</dd></div>
              <div><dt>Experience</dt><dd>5+ years</dd></div>
            </dl>
            <ul class="chips" aria-label="Focus"><li>Cybersecurity</li><li>Cloud engineering</li><li>AI security</li><li>Community</li></ul>
            <div class="barcode" aria-hidden="true"></div>
            <div class="badge-foot mono" aria-hidden="true"><span>Cybersecurity / Cloud / AI</span><span>2026</span></div>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="work" aria-labelledby="work-title" data-work>
      <div class="work-pin" data-work-pin>
        <div class="work-track" data-work-track>
          <div class="work-intro">
            <p class="sec-num">02 — Selected Work</p>
            <h2 id="work-title" class="sec-title">Selected<br />Work</h2>
            <p>Three open-source projects I built — an LLM evaluation dashboard, the agent tooling behind it, and a small exam-prep app.</p>
            <span class="work-hint mono"><svg viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 6h38M33 1l5 5-5 5" /></svg>Keep scrolling</span>
          </div>
          {projects.map((project, i) => (
            <article class="proj">
              {i === 0 && (
                <div class="sticker" aria-hidden="true">
                  <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="49" style="fill:var(--lemon)" /><text style="font:600 9.5px var(--mono);letter-spacing:.12em;fill:var(--on-lemon)"><textPath href="#ring-sticker" textLength="232" lengthAdjust="spacing">FEATURED · FEATURED · FEATURED · </textPath></text></svg>
                  <b>★</b>
                </div>
              )}
              <div class="proj-visual">
                {i === 1 ? (
                  <div class="support-visual" aria-hidden="true">
                    <div class="visual-pane"><div class="pane-head"><span>sawlemon/llm-skills</span><span>main</span></div><div class="tree"><span><b>skills/hill-climb/</b><i>SKILL.md</i></span><span>scripts/codex_learning_extractor.py</span><span><b>tools/cherry-hillclimb/</b><i>apply.mjs</i></span><span>lib/cdp.mjs</span></div><div class="pane-flow">extract → <b>review</b> → apply → verify</div></div>
                    <div class="visual-pane"><div class="pane-head"><span>what the skills do</span><span>84 commits</span></div><div class="tree"><span><b>Hindsight</b> memory protocol</span><span>learning extraction w/ <i>evidence gates</i></span><span>prompt drift detection</span><span>snapshots + rollback</span></div><div class="pane-flow">Claude Code · Codex · ZCode · Cherry Studio</div></div>
                  </div>
                ) : (
                  <div class:list={['frame', { portrait: i === 2 }]}>
                    <img src={project.preview!.src} alt={project.preview!.alt} width={project.preview!.width} height={project.preview!.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  </div>
                )}
              </div>
              <div class="proj-body">
                <span class="proj-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {i === 0 && <p class="mono">01 / Featured</p>}
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
                <div class="proj-links">
                  {project.href && <a class="chip-link solid" href={project.href} target="_blank" rel="noreferrer">View live ↗</a>}
                  {project.sourceHref && <a class="chip-link" href={project.sourceHref} target="_blank" rel="noreferrer">Source ↗</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="work-progress mono" aria-hidden="true"><span data-work-count>01</span><span class="bar"><i data-work-bar></i></span><span>{String(projects.length).padStart(2, '0')}</span></div>
      </div>
    </section>

    <section id="experience" class="sec wrap" aria-labelledby="exp-title">
      <header class="sec-head rv"><span class="sec-num">03</span><h2 id="exp-title" class="sec-title">Experience</h2><p class="sec-aside mono">October 2020 → present</p></header>
      <ol class="stairs" data-stairs>
        {steps.map(([role, dates], i) => (
          <li class:list={['step', { now: i === steps.length - 1 }]} style={`--i:${i}`}>
            {i === steps.length - 1 && <span class="now-tag">NOW</span>}
            <div><time>{dates}</time><h3>{role}</h3></div>
            <div class="step-foot"><span>Presidio</span><span>{String(i + 1).padStart(2, '0')}</span></div>
          </li>
        ))}
      </ol>
      <div class="ground" aria-hidden="true"></div>
      <div class="foundations">
        <h3 class="foundations-label mono">Education</h3>
        {education.map(([name, degree, dates], k) => (
          <article class="slab rv" style={`--d:${k * 0.1}s`}><small>{dates}</small><h3>{name}</h3><p>{degree}</p></article>
        ))}
      </div>
    </section>

    <section id="interests" class="sec wrap" aria-labelledby="int-title">
      <header class="sec-head rv"><span class="sec-num">04</span><h2 id="int-title" class="sec-title">Interests</h2></header>
      <div class="ints">
        {interestGroups.map((group, k) => (
          <details class="int" name="interests" open={k === 0}>
            <summary>
              <span class="int-num">{String(k + 1).padStart(2, '0')}</span>
              <span class="int-title">{group.title}{group.accent && <span class="dot" aria-hidden="true"></span>}</span>
              <span class="int-count">{group.topics.length} {group.topics.length === 1 ? 'topic' : 'topics'}</span>
              <span class="int-plus" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 1v14M1 8h14" /></svg></span>
            </summary>
            <div class="int-body">
              {group.topics.map(([topic, description]) => (
                <div class="topic"><strong>{topic}</strong><span>{description}</span></div>
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="credentials" class="sec wrap" aria-labelledby="cred-title">
      <header class="sec-head rv"><span class="sec-num">05</span><h2 id="cred-title" class="sec-title">Credentials</h2><span class="big-count" data-count={credentials.length} aria-hidden="true">{credentials.length}</span></header>
      <ul class="stamps">
        {credentials.map((cred, k) => (
          <li class:list={['stamp', 'rv', { latest: cred.latest }]} style={`--d:${(k % 4) * 0.06}s;--brand:${(brandLogos as unknown as Record<string, { color: string }>)[cred.issuer]?.color ?? 'inherit'}`}>
            <svg class="seal" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="o" cx="50" cy="50" r="48" />
              <g class="ring"><text class="t"><textPath href="#ring" textLength="230" lengthAdjust="spacing">{stamp(cred.issuer)}</textPath></text></g>
              <circle class="i" cx="50" cy="50" r="27" />
              <use class="lg" href={`#logo-${slug(cred.issuer)}`} x="32" y="32" width="36" height="36" />
            </svg>
            <div>
              <h3>{cred.name}</h3>
              <div class="stamp-meta">
                {cred.date && <time>{cred.date}</time>}
                {cred.latest && <span class="latest-tag">Latest</span>}
              </div>
            </div>
          </li>
        ))}
        <li>
          <a class="stamp more rv" style="--d:.18s;height:100%" href={site.linkedin} target="_blank" rel="noreferrer">
            <span class="arr"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
            <h3>View complete credentials on LinkedIn ↗</h3>
          </a>
        </li>
      </ul>
    </section>

    <section id="writing" class="sec wrap" aria-labelledby="otc-title">
      <header class="sec-head rv"><span class="sec-num">06</span><h2 id="otc-title" class="sec-title">Off the clock</h2><p class="sec-aside mono">Notes &amp; Media · Hobbies</p></header>
      <div class="otc">
        {post && (
          <a class="tile tile-writing rv" href={postUrl} target={postExternal ? '_blank' : undefined} rel={postExternal ? 'noreferrer' : undefined}>
            {post.data.heroImage && (
              <div class="cover"><img src={post.data.heroImage.src} alt={post.data.heroImage.alt} width={post.data.heroImage.width} height={post.data.heroImage.height} loading="lazy" decoding="async" /></div>
            )}
            <div class="tw-body">
              <div class="tw-meta tile-label"><span>Notes &amp; Media</span><span>{monthYear(post.data.publishedDate)}{postExternal && post.data.originalPublication ? ` · ${post.data.originalPublication}` : ''}</span></div>
              <h3>{post.data.title}{postExternal && '\u00A0↗'}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        )}
        <a class="tile tile-music rv" style="--d:.08s" href="/music/">
          <span class="vinyl" aria-hidden="true"></span>
          <div class="tile-head"><span class="tile-label">Hobbies · 01</span><span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div>
          <h3 class="th">Music</h3>
          <p>My Apple Music Replay, from the songs on repeat to the artists that shaped each year.</p>
          <span class="tile-action">Explore Replay <i aria-hidden="true">→</i></span>
        </a>
        <a class="tile tile-reading rv" style="--d:.16s" href="/books/">
          <span class="shelf-mini" aria-hidden="true"><i style="height:70px;background:#1f3a2e"></i><i style="height:84px;background:#7a2e22"></i><i style="height:62px;background:#22355a"></i><i style="height:90px;background:#0f0f0d"></i><i style="height:74px;background:#5c4a1a"></i><i style="height:66px;background:#3e2d52"></i><i style="height:80px;background:#1e5450"></i></span>
          <span class="tile-label">Hobbies · 02</span>
          <h3 class="th">Reading</h3>
          <p>A timeline of the books I have read and what I am reading now.</p>
          <span class="tile-action">Browse Books <i aria-hidden="true">→</i></span>
        </a>
      </div>
    </section>
  </main>

  <div class="slab-end" slot="tail">
    <section id="connect" class="wrap" aria-labelledby="connect-title">
      <p class="connect-label mono">07 — Connect</p>
      <h2 id="connect-title" class="sr-only">Connect</h2>
      <div class="slot" data-slot aria-hidden="true"><ul><li>Building</li><li>Learning</li><li>Vibe hacking</li><li>Sharing</li><li>Building</li></ul></div>
      <p class="sr-only">Building, learning, vibe hacking, sharing.</p>
      <p class="connect-statement">I’m always interested in thoughtful security work, AI experiments, and conversations with people who enjoy building and sharing.</p>
      <div class="contacts">
        <a href={site.linkedin} target="_blank" rel="noreferrer"><b>LinkedIn</b><small>Say hello</small><span class="arr"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></span></a>
        <a href={site.github} target="_blank" rel="noreferrer"><b>GitHub</b><small>@sawlemon</small><span class="arr"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></span></a>
        <span aria-disabled="true"><b>YouTube</b><small>Coming soon</small><span></span></span>
        <span aria-disabled="true"><b>Email</b><small>Coming soon</small><span></span></span>
      </div>
    </section>
    <Footer />
  </div>
</BaseLayout>
