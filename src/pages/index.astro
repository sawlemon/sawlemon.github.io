---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSignal from '../components/home/HeroSignal.astro';
import VelocityBand from '../components/home/VelocityBand.astro';
import { credentials, education, experience, interestGroups, projects, site } from '../data/site';
import { getCollection } from 'astro:content';
import { isExternalPost, postHref } from '../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
const kineticTitle = 'Selected Work';
---

<BaseLayout title="Solomon Raj A | Security, cloud, and AI systems" description={site.description}>
  <Header />
  <main id="main" class="home-page" data-home-motion>
    <div class="hero-shell">
      <HeroSignal />
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow">Cybersecurity / Cloud / AI</p>
          <h1 id="hero-title" class="hero-name">
            <span class="sr-only">Solomon Raj</span>
            <svg class="hero-name-line" viewBox="0 0 700 120" aria-hidden="true" focusable="false">
              <text x="2" y="98" textLength="696" lengthAdjust="spacingAndGlyphs">Solomon Raj</text>
            </svg>
            <svg class="hero-name-stack" viewBox="0 0 700 276" aria-hidden="true" focusable="false">
              <text x="350" y="104" text-anchor="middle">Solomon</text>
              <text x="350" y="236" text-anchor="middle">Raj</text>
            </svg>
          </h1>
          <p class="hero-role">Senior Consultant, Cybersecurity @ Presidio</p>
          <div class="actions"><a class="button button-primary" href="#projects">Explore my work</a><a class="text-link" href="#connect">Connect with me <span aria-hidden="true">→</span></a></div>
          <dl class="hero-facts"><div><dt>Location</dt><dd>Coimbatore, India</dd></div><div><dt>Experience</dt><dd>5+ years</dd></div></dl>
        </div>
      </section>
    </div>

    <div class="wrap main-grid">
      <section id="about" class="section about"><p class="section-label">01 / ABOUT</p><div><h2 class="kinetic-about">I like making complex systems easier to <span class="word">understand</span>, <span class="word">secure</span>, and <span class="word">explain</span>.</h2><p class="about-lead">I’m a Senior Consultant in Cybersecurity at Presidio, specializing in SIEM implementations and endpoint security. My background includes five years across cybersecurity and cloud engineering.</p><div class="two-column"><p>Beyond client work, I mentor, give talks, and stay involved in technical communities, sharing what I learn as I go.</p><ul class="facts-list"><li>Cybersecurity</li><li>Cloud engineering</li><li>AI security</li><li>Community</li></ul></div></div></section>

      <section id="interests" class="section interests-section reveal"><div class="interests-intro"><p class="section-label">02 / INTERESTS</p><h2>Interests</h2></div><div class="interest-matrix">{interestGroups.map((group, groupIndex) => <section class:list={['interest-panel', { accent: group.accent }, { columns: group.columns }]}><div class="panel-head"><span class="panel-index">{String(groupIndex + 1).padStart(2, '0')}</span><h3>{group.title}</h3></div><ul class="topic-list">{group.topics.map(([topic, description]) => <li><strong>{topic}</strong><span>{description}</span></li>)}</ul></section>)}</div></section>
    </div>

    <VelocityBand />

    <div class="wrap main-grid">
      <section id="projects" class="section projects-section reveal"><div class="work-intro"><p class="section-label">03 / SELECTED WORK</p><h2 class="kinetic-heading" aria-label={kineticTitle}><span class="visual" aria-hidden="true">{kineticTitle.split('').map((char) => <span class="char">{char === ' ' ? '\u00A0' : char}</span>)}</span></h2><p>Three open-source projects I built — an LLM evaluation dashboard, the agent tooling behind it, and a small exam-prep app.</p></div><div class="work-grid">{projects.map((project, projectIndex) => <div class:list={['tilt-hit', { 'lead-hit': projectIndex === 0 }]}><article class:list={['work-card', { lead: projectIndex === 0 }]} data-tilt><div class="card-visual">{project.preview ? <img src={project.preview.src} alt={project.preview.alt} width={project.preview.width} height={project.preview.height} loading={projectIndex === 0 ? 'eager' : 'lazy'} decoding="async" /> : <div class="support-visual"><div class="visual-pane"><div class="pane-head"><span>sawlemon/llm-skills</span><span>main</span></div><div class="tree"><span><b>skills/hill-climb/</b><i>SKILL.md</i></span><span>scripts/codex_learning_extractor.py</span><span><b>tools/cherry-hillclimb/</b><i>apply.mjs</i></span><span>lib/cdp.mjs</span></div><div class="pane-flow">extract → <b>review</b> → apply → verify</div></div><div class="visual-pane"><div class="pane-head"><span>what the skills do</span><span>84 commits</span></div><div class="tree"><span><b>Hindsight</b> memory protocol</span><span>learning extraction w/ <i>evidence gates</i></span><span>prompt drift detection</span><span>snapshots + rollback</span></div><div class="pane-flow">Claude Code · Codex · ZCode · Cherry Studio</div></div></div>}</div><p class="card-index">{String(projectIndex + 1).padStart(2, '0')}{projectIndex === 0 && ' / FEATURED'}</p><div class="card-body"><h3>{project.title}</h3><p>{project.description}</p><ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul><div class="card-links">{project.href && <a class="text-link" href={project.href} target="_blank" rel="noreferrer">View live ↗</a>}{project.sourceHref && <a class="text-link" href={project.sourceHref} target="_blank" rel="noreferrer">Source ↗</a>}</div></div></article></div>)}</div></section>

      <section class="section reveal" id="writing"><p class="section-label">04 / NOTES & MEDIA</p>{posts.length ? <div class="post-list">{posts.map((post) => { const external = isExternalPost(post); const href = postHref(post); return <article>{post.data.heroImage && <a class="post-cover" href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined} tabindex="-1"><img src={post.data.heroImage.src} alt={post.data.heroImage.alt} width={post.data.heroImage.width} height={post.data.heroImage.height} loading="lazy" decoding="async" /></a>}<p class="eyebrow">{post.data.publishedDate.toLocaleDateString('en', { month: 'short', year: 'numeric' })}{external && ` · ${post.data.originalPublication}`}</p><h3><a href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>{post.data.title}{external && '\u00A0↗'}</a></h3><p>{post.data.description}</p></article>; })}</div> : <div class="empty-state"><h2>Writing is coming soon.</h2><p>Articles will be published here as Markdown files in this repository.</p><a class="text-link" href="/blog/">Visit the blog <span aria-hidden="true">→</span></a></div>}</section>

      <section id="experience" class="section exp-section reveal"><div class="exp-intro"><p class="section-label">05 / EXPERIENCE</p><h2>Experience</h2></div><div class="timeline" data-motion-roles>{experience.map(([role, dates]) => <article><span></span><div class="exp-row"><h3>{role} <span class="exp-employer">— Presidio</span></h3><p>{dates}</p></div></article>)}</div><div class="education-block"><p class="section-label">05.1 / EDUCATION</p><h2>Education</h2><div class="education-grid" data-motion-education>{education.map(([institution, degree, dates]) => <article><small>{dates}</small><h3>{institution}</h3><p>{degree}</p></article>)}</div></div></section>

      <section class="section"><p class="section-label">06 / CREDENTIALS</p><div class="credential-grid">{credentials.map(([name, note]) => <article><span>{name}</span>{note && <small class:list={{ latest: note === 'Latest' }}>{note}</small>}</article>)}</div><a class="text-link" href={site.linkedin} target="_blank" rel="noreferrer">View complete credentials on LinkedIn ↗</a></section>

      <section id="connect" class="connect-section reveal"><p class="section-label">07 / CONNECT</p><h2>I’m always interested in thoughtful security work, AI experiments, and conversations with people who enjoy building and sharing.</h2><div class="contact-list"><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href={site.github} target="_blank" rel="noreferrer">GitHub <span>↗</span></a><span aria-disabled="true">YouTube <small>Coming soon</small></span><span aria-disabled="true">Email <small>Coming soon</small></span></div></section>

      <section id="hobbies" class="section hobbies-section"><p class="eyebrow hobbies-label"><span class="hobbies-marker" aria-hidden="true"></span>[ 08 / HOBBIES ]</p><div class="hobby-grid"><a class="hobby-card" href="/music/"><div class="hobby-head"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg><h3>Music</h3></div><p>My Apple Music Replay, from the songs on repeat to the artists that shaped each year.</p><span class="hobby-action">Explore Replay <span aria-hidden="true">→</span></span></a><a class="hobby-card" href="/books/"><div class="hobby-head"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"/></svg><h3>Reading</h3></div><p>A timeline of the books I have read and what I am reading now.</p><span class="hobby-action">Browse Books <span aria-hidden="true">→</span></span></a></div></section>
    </div>
  </main>
  <Footer />
  <script>
    import '../scripts/home-motion.ts';
  </script>
</BaseLayout>
