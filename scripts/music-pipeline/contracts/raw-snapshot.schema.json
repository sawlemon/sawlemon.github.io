{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw-snapshot.schema.json",
  "title": "Replay snapshot manifest",
  "description": "Written by scripts/music-pipeline/snapshots/store.mjs after a completed acquisition run. Never contains URLs with query strings, request headers, tokens, cookies, or browser-profile data.",
  "type": "object",
  "required": ["schemaVersion", "runId", "source", "fetchedAt", "years", "snapshots"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "source": { "const": "apple-music-replay" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "years": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{4}$" }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id", "path", "status"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["year", "month"] },
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^raw/[^/].*$" },
          "status": { "enum": ["present", "absent"] },
          "httpStatus": { "type": "integer", "minimum": 0 },
          "observedAt": { "type": "string", "format": "date-time" },
          "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "coverage": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
