---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import Sprite from '../components/Sprite.astro';
import Header from '../components/Header.astro';
import Dock from '../components/Dock.astro';

interface Props {
  title: string;
  description: string;
  page: 'home' | 'books' | 'music' | 'blog';
}

const { title, description, page } = Astro.props;
---

<!doctype html>
<html id="top" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="alternate" type="application/rss+xml" title="Sawlemon blog" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var savedTheme = null;
        try {
          savedTheme = localStorage.getItem('theme');
        } catch (error) {
          /* storage blocked — fall through to OS preference */
        }
        var q = new URLSearchParams(location.search).get('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = q === 'light' || q === 'dark' ? q : savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : prefersDark ? 'dark' : 'light';
        root.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0c0c0b' : '#eeece5');
      })();
    </script>
    <title>{title}</title>
  </head>
  <body data-page={page} class:list={[{ subpage: page !== 'home' }]}>
    <Sprite />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <Dock page={page} />
    <main id="main">
      <slot />
    </main>
    <slot name="tail" />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
